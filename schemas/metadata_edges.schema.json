{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metadata_edges",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^e_[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "child_model_id": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "parent_model_id": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "relation": {
      "enum": [
        "fine_tune",
        "adapter",
        "merge",
        "quantization",
        "other"
      ]
    },
    "lineage_status": {
      "enum": [
        "declared",
        "inferred",
        "audited"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "revision",
          "field",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "edge_id",
    "snapshot_id",
    "child_model_id",
    "parent_model_id",
    "relation",
    "lineage_status",
    "evidence"
  ],
  "additionalProperties": false
}