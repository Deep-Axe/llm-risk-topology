{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model_manifests",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^models_[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "stage": {
      "enum": [
        "pilot",
        "8",
        "25",
        "100"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tokenizer_revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "chat_template_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary_assistant",
              "base_diagnostic"
            ]
          },
          "precision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "system_policy": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model_id",
          "revision",
          "tokenizer_revision",
          "chat_template_sha256",
          "family",
          "role",
          "precision",
          "system_policy"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "stage",
    "models"
  ],
  "additionalProperties": false
}