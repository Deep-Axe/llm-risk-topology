{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "responses",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "response_id": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{64}$"
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^p_[0-9a-f]{64}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "input_truncated": {
      "type": "boolean"
    },
    "output_truncated": {
      "type": "boolean"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "response_id",
    "run_id",
    "prompt_id",
    "model_id",
    "model_revision",
    "repetition",
    "status",
    "text",
    "error",
    "input_tokens",
    "output_tokens",
    "input_truncated",
    "output_truncated",
    "finish_reason"
  ],
  "additionalProperties": false
}